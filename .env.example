# Public site URL — used for canonical links, sitemap, OG/Twitter meta, JSON-LD.
NUXT_PUBLIC_SITE_URL=https://homerack.mraguz.com

# Where the SQLite survey database lives. In Docker this should point inside the
# mounted volume (see docker-compose.yml) so data survives container recreation.
# NUXT_ prefix required — that's how Nuxt's runtimeConfig picks up env overrides.
NUXT_DATABASE_PATH=./data/homerack.db

# REQUIRED (docker-compose.yml refuses to start without it). Salt used to hash IPs
# for the survey endpoint's rate limiter — raw IPs are never stored, only a salted
# hash. Any random string of your choosing; changing it just resets rate-limit
# history, it doesn't affect stored responses.
NUXT_SURVEY_IP_SALT=change-me-to-a-random-string

# REQUIRED (docker-compose.yml refuses to start without it). Keeps OG image URLs
# stable across restarts/redeploys (otherwise every restart invalidates previously-
# shared social preview links until they're re-crawled).
# Generate one with: npx nuxt-og-image generate-secret
NUXT_OG_IMAGE_SECRET=change-me-generate-with-npx-nuxt-og-image-generate-secret
